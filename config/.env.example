# 第三方LLM配置
LLM_BASEURL="<配置地址>"
LLM_APIKEY="<API密钥>"
LLM_MODEL="<模型名称>"
LLM_PROVIDER="<LLM提供商名称>"

# 语义 Payload 迭代专用 LLM
SEMANTIC_LLM_BASEURL="https://apiai.sztu.edu.cn/v1"
SEMANTIC_LLM_APIKEY="<API密钥>"
SEMANTIC_LLM_MODEL="deepseek-chat"
SEMANTIC_LLM_PROVIDER="SZTU"
SEMANTIC_LLM_ALLOW_FALLBACK=false
SEMANTIC_LLM_BATCH_SIZE=1
SEMANTIC_LLM_MAX_RETRIES=2

# DVWA + 雷池 WAF 测试场（仅由后端读取）
WAF_DVWA_BASE_URL="http://<DVWA地址>:<端口>"
WAF_DVWA_USERNAME="<DVWA账号>"
WAF_DVWA_PASSWORD="<DVWA密码>"

# 腾讯云 WAF 直接测试场（请求发往 IP，并使用指定 Host 头）
TENCENT_WAF_IP="<腾讯云WAF接入IP>"
TENCENT_WAF_HOST="<腾讯云WAF防护域名>"

# 独立 LLM 检验 Agent（可选覆盖，缺省回退到 SEMANTIC_LLM / LLM）
VERIFY_LLM_BASEURL=""
VERIFY_LLM_APIKEY=""
VERIFY_LLM_MODEL=""
VERIFY_LLM_PROVIDER="Verification-Judge"

# 自动检验开关与受控并发
AUTO_VERIFY=true
VERIFY_CONCURRENCY=3

# 检验靶场注册表
RANGE_CMDI_DVWA_BASE_URL="http://111.230.233.61:8111"
RANGE_XSS_DVWA_BASE_URL="http://111.230.233.61:8111"
RANGE_DVWA_USERNAME="admin"
RANGE_DVWA_PASSWORD="password"
RANGE_SQLI_BASE_URL="http://111.230.233.61:9200"
RANGE_LOG4J_BASE_URL="http://111.230.233.61:8112"
RANGE_UPLOAD_BASE_URL="http://111.230.233.61:18080"
RANGE_UPLOAD_FILE_FIELD="file"
RANGE_UPLOAD_FILENAME="shell.jsp"

# OOB 外带回连监听（XSS Cookie 外带自动闭环验证）
OOB_LISTENER_URL="http://8.129.25.140:12345"
OOB_WAIT_SECONDS=8
