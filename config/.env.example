# 第三方LLM配置（语义/编码/检验 Agent 统一使用）
LLM_BASEURL="<配置地址>"
LLM_APIKEY="<API密钥>"
LLM_MODEL="<模型名称>"
LLM_PROVIDER="<LLM提供商名称>"

# 独立 LLM 检验 Agent（可选覆盖，缺省回退到 LLM_*）
VERIFY_LLM_BASEURL=""
VERIFY_LLM_APIKEY=""
VERIFY_LLM_MODEL=""
VERIFY_LLM_PROVIDER="Verification-Judge"

# 自动检验开关与受控并发
AUTO_VERIFY=true
VERIFY_CONCURRENCY=3
# 检验内队列容量（同时处于 queued+running 的候选数上限；超出进入 waiting 待测试队列）
VERIFY_QUEUE_CAPACITY=5

# 检验靶场注册表
# 所有靶场均直连源站 IP 81.71.196.49，携带自定义 Host 头 miniproject-vuln.testwaf.com，
# 经腾讯云 WAF 按 Host 路由。源站各端口：80=cmdi/xss(DVWA) 9200=sql 8006=log4j
# 8005=上传(php) 8007=上传(jsp)。
RANGE_CMDI_DVWA_BASE_URL="http://81.71.196.49"
RANGE_XSS_DVWA_BASE_URL="http://81.71.196.49"
RANGE_DVWA_USERNAME="admin"
RANGE_DVWA_PASSWORD="password"

RANGE_SQLI_BASE_URL="http://81.71.196.49:9200"
RANGE_SQLI_HOST="miniproject-vuln.testwaf.com"

RANGE_LOG4J_BASE_URL="http://81.71.196.49:8006"
RANGE_LOG4J_HOST="miniproject-vuln.testwaf.com"

# 文件上传（php upload-labs）
RANGE_UPLOAD_PHP_BASE_URL="http://81.71.196.49:8005"
RANGE_UPLOAD_PHP_HOST="miniproject-vuln.testwaf.com"
RANGE_UPLOAD_PHP_FILE_FIELD="upload_file"
RANGE_UPLOAD_PHP_FILENAME="shell.php"

# 文件上传（jsp upload-labs）
RANGE_UPLOAD_JSP_BASE_URL="http://81.71.196.49:8007"
RANGE_UPLOAD_JSP_HOST="miniproject-vuln.testwaf.com"
RANGE_UPLOAD_JSP_FILE_FIELD="file"
RANGE_UPLOAD_JSP_FILENAME="shell.jsp"

# 套 WAF 的 DVWA（cmdi/xss）直连通道：请求直连源站 IP（RANGE_*_DVWA_BASE_URL），
# 携带自定义 Host 头 + 预置会话 Cookie，跳过登录（登录会被 WAF 干扰）。
# HOST 与 COOKIE 均配置才启用直连；否则回退到账密登录。
RANGE_CMDI_HOST="miniproject-vuln.testwaf.com"
RANGE_CMDI_COOKIE="PHPSESSID=...; security=low"
RANGE_XSS_HOST="miniproject-vuln.testwaf.com"
RANGE_XSS_COOKIE="PHPSESSID=...; security=low"
# 命令注入前缀模板（可选，默认 "-c 1 127.0.0.1;"）
# RANGE_CMDI_PREFIX="-c 1 127.0.0.1;"

# OOB 外带回连监听（XSS Cookie 外带自动闭环验证）
OOB_LISTENER_URL="http://8.129.25.140:12345"
OOB_WAIT_SECONDS=8
