# 第三方LLM配置
LLM_BASEURL="<配置地址>"
LLM_APIKEY="<API密钥>"
LLM_MODEL="<模型名称>"
LLM_PROVIDER="<LLM提供商名称>"

# 语义 Payload 迭代专用 LLM（配置完整时优先使用；缺失时回退上方 LLM_*）
SEMANTIC_LLM_BASEURL="https://token.sensenova.cn/v1"
SEMANTIC_LLM_APIKEY="<API密钥>"
SEMANTIC_LLM_MODEL="deepseek-v4-flash"
SEMANTIC_LLM_PROVIDER="sensenova"

# DVWA + 雷池 WAF 测试场（仅由后端读取）
WAF_DVWA_BASE_URL="http://<DVWA地址>:<端口>"
WAF_DVWA_USERNAME="<DVWA账号>"
WAF_DVWA_PASSWORD="<DVWA密码>"

# 腾讯云 WAF 直接测试场（请求发往 IP，并使用指定 Host 头）
TENCENT_WAF_IP="<腾讯云WAF接入IP>"
TENCENT_WAF_HOST="<腾讯云WAF防护域名>"
